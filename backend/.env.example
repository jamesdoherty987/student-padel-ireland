# App
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
# Public URL of this API (used for absolute profile media links in production)
BACKEND_URL=http://localhost:8000

# Database — SQLite for local, Supabase Postgres for production
# Paste the Supabase URI as-is (postgres:// or postgresql://); the app adds +psycopg2.
# Example: postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./padel.db

# Demo seed (james@ul.ie etc.) — auto-on in development, auto-off in production
# SEED_DEMO_DATA=true

# Production bootstrap when demo seed is off (empty DB only)
# ADMIN_EMAIL=you@studentpadelireland.ie
# ADMIN_PASSWORD=use-a-long-random-password
# ADMIN_NAME=Platform Admin

# Supabase (service role NEVER exposed to frontend — optional for now)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — leave blank for demo (free) registration; fill when charging entry fees
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Email (Resend) — optional
RESEND_API_KEY=
EMAIL_FROM=Student Padel Ireland <noreply@studentpadelireland.ie>

# Extra CORS origins (comma-separated). Capacitor WebView origin is already included.
# CORS_EXTRA_ORIGINS=https://preview.vercel.app
